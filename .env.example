# Copy to .env (gitignored) and fill in your own Supabase project values,
# or export these as real environment variables / IDE run-config entries.
# Never commit the filled-in version of this file.

SUPABASE_DB_URL=jdbc:postgresql://<PROJECT_REF>.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-db-password>

# Optional overrides
CORS_ALLOWED_ORIGIN=http://localhost:5173
SERVER_PORT=8080

# --- Lab 3: LegacySupply (never commit real values) ---
LS_CLIENT_ID=<your student id>
LS_API_KEY=<key from your instructor>

# productId:SupplierSku:PackSize from GET /catalog, comma separated
SUPPLIER_CATALOG=P100:<sku>:<pack>,P200:<sku>:<pack>,P400:<sku>:<pack>
# Cancellation code seen in the log line 'Unexpected supplier status XX'
SUPPLIER_CANCELLED_CODES=

# Tiangge uses the same LS_CLIENT_ID and LS_API_KEY values above.
# Optional endpoint override for the Tiangge seller API.
TIANGGE_BASE_URL=https://legacysupply.onrender.com/tiangge/v1
